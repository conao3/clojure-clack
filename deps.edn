{:deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  info.sunng/ring-jetty9-adapter {:mvn/version "0.40.5"
                                  :exclusions [org.slf4j/slf4j-api]}
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  spootnik/unilog {:mvn/version "0.7.32"}
  com.stuartsierra/component {:mvn/version "1.2.0"}
  metosin/reitit {:mvn/version "0.11.0"}
  metosin/ring-http-response {:mvn/version "0.9.5"}
  ring-logger/ring-logger {:mvn/version "1.1.1"}
  metosin/muuntaja {:mvn/version "0.6.12"}
  camel-snake-kebab/camel-snake-kebab {:mvn/version "0.4.3"}
  org.clojure/core.memoize {:mvn/version "1.2.281"}}

 :aliases
 {:dev
  {:extra-paths ["dev"]}

  :build
  {:deps {com.github.liquidz/build.edn
          {:git/tag "0.11.266" :git/sha "849302d"}}
   :ns-default build-edn.main}

  :test
  {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
   :main-opts ["-m" "kaocha.runner"]}}}
